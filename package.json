    "test:claim-pack": "node --test tests/claim-pack.test.mjs",
    "test:workflow": "node --test tests/workflow.test.mjs",
    "test:demo-project": "node --test tests/demo-project.test.mjs",
    "test:form-buffer": "node --test tests/form-buffer.test.mjs",
